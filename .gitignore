# ---------------------------------------------------------------------------
# Machine-local overrides — NEVER committed
# ---------------------------------------------------------------------------
# bootstrap.sh creates empty ~/.zshrc.local / ~/.gitconfig.local if missing.
# Put host-specific things there so the tracked config stays portable:
#   - CUDA / vendor SDK PATH and *_HOME variables
#   - host-only ulimit tweaks
#   - git credential helper / signing keys
# ---------------------------------------------------------------------------
.zshrc.local
.gitconfig.local

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# LazyVim / NeoVim
nvim/spell/
nvim/plugin/packer_compiled.lua

# Editor backups
*~
*.swp
*.swo

# OS generated files
Thumbs.db
ehthumbs.db
