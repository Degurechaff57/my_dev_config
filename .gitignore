# ---------------------------------------------------------------------------
# Machine-local interactive shell overrides — NEVER committed
# ---------------------------------------------------------------------------
# bootstrap.sh creates an empty ~/.zshrc.local if missing. Put host-specific
# things there so the tracked config stays portable:
#   - CUDA / vendor SDK PATH and *_HOME variables
#   - host-only ulimit tweaks
#   - host-only aliases and functions
# ---------------------------------------------------------------------------
.zshrc.local

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# LazyVim / NeoVim
nvim/spell/
nvim/plugin/packer_compiled.lua

# Editor backups
*~
*.swp
*.swo

# OS generated files
Thumbs.db
ehthumbs.db
