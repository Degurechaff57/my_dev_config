# =============================================================================
# Secrets and API Keys (cross-shell: sourced by both bash and zsh)
# Copy this file to shared/secrets.sh and fill in your actual keys.
# shared/secrets.sh is git-ignored — never commit real tokens!
# =============================================================================

# ---------- Anthropic-compatible LLM API ----------
# Fill in your API base URL and auth token for Claude Code or other
# Anthropic SDK-compatible tools (e.g., DeepSeek, OpenRouter, etc.)
# export ANTHROPIC_BASE_URL="https://api.anthropic.com"
# export ANTHROPIC_AUTH_TOKEN="your-api-key-here"
# export ANTHROPIC_MODEL="claude-sonnet-4-6"
# export ANTHROPIC_DEFAULT_OPUS_MODEL="claude-opus-4-7"
# export ANTHROPIC_DEFAULT_SONNET_MODEL="claude-sonnet-4-6"
# export ANTHROPIC_DEFAULT_HAIKU_MODEL="claude-haiku-4-5"
# export CLAUDE_CODE_SUBAGENT_MODEL="claude-haiku-4-5"
# export CLAUDE_CODE_EFFORT_LEVEL="max"

# ---------- Other API keys ----------
# export OPENAI_API_KEY="sk-your-openai-key-here"
# export HUGGINGFACE_TOKEN="hf_your-token-here"
